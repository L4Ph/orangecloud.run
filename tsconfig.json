{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "crons",
    "db",
    "docs",
    "durable-objects",
    "lessons",
    "lib",
    "lingui.config.ts",
    "locales",
    "middleware",
    "pages",
    "queues",
    "routes",
    "src"
  ]
}
